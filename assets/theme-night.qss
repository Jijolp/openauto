/* ==========================================================================
 * OpenAuto head-unit theme (UI-2b NIGHT — pure black, dimmed) — loaded at startup from
 * <repo>/assets/theme-night.qss (NOT compiled in). Edit & restart to preview.
 *
 * Palette (Nothing-style):
 *   @background  #000000   main windows, idle screen
 *   @panel       #050506   dialogs, group boxes, inputs, quadrants
 *   @panel-hi    #0A0A0C   quadrant hover
 *   @border      #1C1C20   frames, separators
 *   @text        #C9C9C9   primary text
 *   @text-dim    #6E6E6E   secondary text, placeholders, SOON
 *   @accent      #7A0F14   Nothing red: buttons, focus, links, clock
 *   @accent-hi   #96131B   accent hover/pressed
 *   @on-accent   #FFFFFF   text on accent
 *   @overlay-bg  rgba(0, 0, 0, 220)  status bar over video
 *   Inter — bundled in assets/fonts, fallback sans-serif.
 * ========================================================================== */

QMainWindow, QDialog, QWidget {
    background-color: #000000;
    color: #C9C9C9;
    font-family: "Inter", sans-serif;
    font-size: 14px;
}

QLabel {
    background: transparent;
    color: #C9C9C9;
}

QLabel:disabled {
    color: #6E6E6E;
}

QPushButton {
    background-color: #050506;
    border: 1px solid #1C1C20;
    border-radius: 6px;
    color: #C9C9C9;
    padding: 8px 16px;
}

QPushButton:hover {
    border: 1px solid #7A0F14;
}

QPushButton:pressed {
    background-color: #7A0F14;
    color: #FFFFFF;
    border: 1px solid #7A0F14;
}

QPushButton:focus {
    border: 1px solid #7A0F14;
    outline: none;
}

QPushButton:disabled {
    color: #6E6E6E;
    border: 1px solid #1C1C20;
}

QCheckBox, QRadioButton {
    color: #C9C9C9;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #7A0F14;
    border: 1px solid #7A0F14;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #050506;
    border: 1px solid #1C1C20;
}

QGroupBox {
    border: 1px solid #1C1C20;
    border-radius: 6px;
    margin-top: 12px;
    color: #C9C9C9;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #6E6E6E;
}

QLineEdit, QSpinBox {
    background-color: #050506;
    border: 1px solid #1C1C20;
    border-radius: 4px;
    color: #C9C9C9;
    padding: 4px;
    selection-background-color: #7A0F14;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #7A0F14;
}

QSlider::groove:horizontal {
    background: #1C1C20;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #7A0F14;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QTabWidget::pane {
    border: 1px solid #1C1C20;
    background: #000000;
}

QTabBar::tab {
    background: #050506;
    color: #6E6E6E;
    padding: 8px 16px;
    border: 1px solid #1C1C20;
    border-bottom: none;
}

QTabBar::tab:selected {
    background: #000000;
    color: #C9C9C9;
    border-top: 2px solid #7A0F14;
}

QListView, QListWidget {
    background-color: #050506;
    border: 1px solid #1C1C20;
    color: #C9C9C9;
    selection-background-color: #7A0F14;
    selection-color: #FFFFFF;
}

QListView::item:selected, QListWidget::item:selected {
    background-color: #7A0F14;
    color: #FFFFFF;
}

QProgressBar {
    background-color: #050506;
    border: 1px solid #1C1C20;
    border-radius: 4px;
    color: #C9C9C9;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #7A0F14;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: #000000;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #1C1C20;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #7A0F14;
}

/* ---- Status bar overlay (object names, see StatusBar.cpp) ---- */
StatusBar {
    background: #000000;
}

#labelClock {
    color: #C9C9C9;
    font-size: 22px;
    font-weight: bold;
}

#labelTemp, #labelSignal {
    color: #6E6E6E;
    font-size: 16px;
}

/* ---- UI-2a skeleton pages (object names, see MainWindow.cpp) ---- */
#pageTitle {
    color: #C9C9C9;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 0.6px;
}

#pageSubtitle {
    color: #6E6E6E;
    font-size: 13px;
    letter-spacing: 0.8px;
}

/* ---- UI-2b: home quadrants + Nothing premium ---- */
#homePage {
    background-color: #000000;
}

/* AA page: opaque black so any letterbox around the phone render is pure
 * black, never compositor bleed-through (cf. BUILD_NOTES §28). */
#aaPage {
    background-color: #000000;
}

QPushButton#quadrantAA,
QPushButton#quadrantRace,
QPushButton#quadrantCar,
QPushButton#quadrantParams {
    background-color: #050506;
    border: 1px solid #1C1C20;
    color: #C9C9C9;
    font-family: "Inter", sans-serif;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: 1.6px;
    padding: 18px;
    /* wide empty feel: min-height via padding, border handled per id */
}

QPushButton#quadrantAA {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 70px;
}
QPushButton#quadrantRace {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 70px;
    border-bottom-right-radius: 6px;
}
QPushButton#quadrantCar {
    border-top-left-radius: 6px;
    border-top-right-radius: 70px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
QPushButton#quadrantParams {
    border-top-left-radius: 70px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton#quadrantAA:hover,
QPushButton#quadrantRace:hover,
QPushButton#quadrantCar:hover,
QPushButton#quadrantParams:hover {
    background-color: #0A0A0C;
    border: 1px solid #7A0F14;
}

QPushButton#quadrantAA:pressed,
QPushButton#quadrantRace:pressed,
QPushButton#quadrantCar:pressed,
QPushButton#quadrantParams:pressed {
    background-color: #7A0F14;
    color: #FFFFFF;
    border: 1px solid #7A0F14;
}

QPushButton#quadrantRace:disabled,
QPushButton#quadrantCar:disabled {
    background-color: #020203;
    color: #4A4A4A;
    border: 1px solid #121214;
}

/* center Mercedes logo button (tappable → screen off) */
QPushButton#centerLogoButton {
    background: #000000;
    border: 1px solid #1C1C20;
    border-radius: 90px;
    padding: 0px;
}
QPushButton#centerLogoButton:hover {
    border: 1px solid #232326;
    background: #050506;
}
QPushButton#centerLogoButton:pressed {
    background: #7A0F14;
    border: 1px solid #7A0F14;
}

/* AA bandeau home button (inside StatusBar, 48px hit) */
QPushButton#aaHomeButton {
    background: #050506;
    border: 1px solid #1C1C20;
    border-radius: 8px;
    padding: 0px;
}
QPushButton#aaHomeButton:hover {
    border: 1px solid #7A0F14;
    background: #0A0A0C;
}
QPushButton#aaHomeButton:pressed {
    background: #7A0F14;
    border: 1px solid #7A0F14;
}

/* Mini-cluster AA flottant bas-droite (cf. theme.qss ; déjà noir). */
#aaCluster {
    background-color: rgba(5, 5, 6, 215);
    border: 1px solid #1C1C20;
    border-radius: 10px;
}

#aaClock {
    color: #C9C9C9;
    font-size: 16px;
    font-weight: bold;
}

#aaTemp, #aaSignal {
    color: #6E6E6E;
    font-size: 13px;
}

QPushButton#aaFloatingButton {
    background: #050506;
    border: 1px solid #1C1C20;
    border-radius: 8px;
    padding: 0px;
}
QPushButton#aaFloatingButton:hover {
    border: 1px solid #7A0F14;
    background: #0A0A0C;
}
QPushButton#aaFloatingButton:pressed {
    background: #7A0F14;
    border: 1px solid #7A0F14;
}

#devHint {
    color: #4A4A4A;
    font-size: 11px;
    letter-spacing: 1.2px;
}
QPushButton#nightToggle {
    background: #050506;
    border: 1px solid #1C1C20;
    border-radius: 6px;
    font-size: 11px;
    letter-spacing: 1.0px;
    padding: 4px 10px;
}
QPushButton#nightToggle:checked {
    background: #1A1A1A;
    border: 1px solid #232326;
}

/* SOON badge on disabled quadrants */
QLabel#soonBadge {
    color: #6E6E6E;
    background: transparent;
    padding: 2px 6px;
}
