/* ==========================================================================
 * OpenAuto head-unit theme (UI-2b Nothing/Mercedes) — loaded at startup from
 * <repo>/assets/theme.qss (NOT compiled in). Edit & restart to preview.
 *
 * Palette (Nothing-style):
 *   @background  #0D0D0F   main windows, idle screen
 *   @panel       #17171B   dialogs, group boxes, inputs, quadrants
 *   @panel-hi    #1E1E24   quadrant hover
 *   @border      #2A2A30   frames, separators
 *   @text        #F5F5F5   primary text
 *   @text-dim    #9E9E9E   secondary text, placeholders, SOON
 *   @accent      #D71920   Nothing red: buttons, focus, links, clock
 *   @accent-hi   #F02830   accent hover/pressed
 *   @on-accent   #FFFFFF   text on accent
 *   @overlay-bg  rgba(13, 13, 15, 180)  status bar over video
 *   Inter — bundled in assets/fonts, fallback sans-serif.
 * ========================================================================== */

QMainWindow, QDialog, QWidget {
    background-color: #0D0D0F;
    color: #F5F5F5;
    font-family: "Inter", sans-serif;
    font-size: 14px;
}

QLabel {
    background: transparent;
    color: #F5F5F5;
}

QLabel:disabled {
    color: #9E9E9E;
}

QPushButton {
    background-color: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 6px;
    color: #F5F5F5;
    padding: 8px 16px;
}

QPushButton:hover {
    border: 1px solid #D71920;
}

QPushButton:pressed {
    background-color: #D71920;
    color: #FFFFFF;
    border: 1px solid #D71920;
}

QPushButton:focus {
    border: 1px solid #D71920;
    outline: none;
}

QPushButton:disabled {
    color: #9E9E9E;
    border: 1px solid #2A2A30;
}

QCheckBox, QRadioButton {
    color: #F5F5F5;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #D71920;
    border: 1px solid #D71920;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #17171B;
    border: 1px solid #2A2A30;
}

QGroupBox {
    border: 1px solid #2A2A30;
    border-radius: 6px;
    margin-top: 12px;
    color: #F5F5F5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #9E9E9E;
}

QLineEdit, QSpinBox {
    background-color: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 4px;
    color: #F5F5F5;
    padding: 4px;
    selection-background-color: #D71920;
}

QLineEdit:focus, QSpinBox:focus {
    border: 1px solid #D71920;
}

QSlider::groove:horizontal {
    background: #2A2A30;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #D71920;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QTabWidget::pane {
    border: 1px solid #2A2A30;
    background: #0D0D0F;
}

QTabBar::tab {
    background: #17171B;
    color: #9E9E9E;
    padding: 8px 16px;
    border: 1px solid #2A2A30;
    border-bottom: none;
}

QTabBar::tab:selected {
    background: #0D0D0F;
    color: #F5F5F5;
    border-top: 2px solid #D71920;
}

QListView, QListWidget {
    background-color: #17171B;
    border: 1px solid #2A2A30;
    color: #F5F5F5;
    selection-background-color: #D71920;
    selection-color: #FFFFFF;
}

QListView::item:selected, QListWidget::item:selected {
    background-color: #D71920;
    color: #FFFFFF;
}

QProgressBar {
    background-color: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 4px;
    color: #F5F5F5;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #D71920;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: #0D0D0F;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #2A2A30;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #D71920;
}

/* ---- Status bar overlay (object names, see StatusBar.cpp) ---- */
StatusBar {
    background: #0D0D0F;
}

#labelClock {
    color: #F5F5F5;
    font-size: 22px;
    font-weight: bold;
}

#labelTemp, #labelSignal {
    color: #9E9E9E;
    font-size: 16px;
}

/* ---- UI-2a skeleton pages (object names, see MainWindow.cpp) ---- */
#pageTitle {
    color: #F5F5F5;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 0.6px;
}

#pageSubtitle {
    color: #9E9E9E;
    font-size: 13px;
    letter-spacing: 0.8px;
}

/* ---- UI-2b: home quadrants + Nothing premium ---- */
#homePage {
    background-color: #0D0D0F;
}

/* AA page: opaque black so any letterbox around the phone render is pure
 * black, never compositor bleed-through (cf. BUILD_NOTES §28). */
#aaPage {
    background-color: #000000;
}

QPushButton#quadrantAA,
QPushButton#quadrantRace,
QPushButton#quadrantCar,
QPushButton#quadrantParams {
    background-color: #17171B;
    border: 1px solid #2A2A30;
    color: #F5F5F5;
    font-family: "Inter", sans-serif;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: 1.6px;
    padding: 18px;
    /* wide empty feel: min-height via padding, border handled per id */
}

QPushButton#quadrantAA {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 70px;
}
QPushButton#quadrantRace {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 70px;
    border-bottom-right-radius: 6px;
}
QPushButton#quadrantCar {
    border-top-left-radius: 6px;
    border-top-right-radius: 70px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}
QPushButton#quadrantParams {
    border-top-left-radius: 70px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton#quadrantAA:hover,
QPushButton#quadrantRace:hover,
QPushButton#quadrantCar:hover,
QPushButton#quadrantParams:hover {
    background-color: #1E1E24;
    border: 1px solid #D71920;
}

QPushButton#quadrantAA:pressed,
QPushButton#quadrantRace:pressed,
QPushButton#quadrantCar:pressed,
QPushButton#quadrantParams:pressed {
    background-color: #D71920;
    color: #FFFFFF;
    border: 1px solid #D71920;
}

QPushButton#quadrantRace:disabled,
QPushButton#quadrantCar:disabled {
    background-color: #0F0F12;
    color: #6E6E6E;
    border: 1px solid #1C1C20;
}

/* center Mercedes logo button (tappable → screen off), 180px per UiConstants */
QPushButton#centerLogoButton {
    background: #0D0D0F;
    border: 1px solid #2A2A30;
    border-radius: 90px;
    padding: 0px;
}
QPushButton#centerLogoButton:hover {
    border: 1px solid #3A3A40;
    background: #17171B;
}
QPushButton#centerLogoButton:pressed {
    background: #D71920;
    border: 1px solid #D71920;
}

/* Mini-cluster AA flottant bas-droite (horloge + temp + signal + logo).
 * Pilule semi-opaque fondue dans la barre AA du bas (au-dessus de la
 * vidéo opaque : pas de fuite compositor). Conteneur + labels
 * click-transparents, seul le bouton prend les clics. */
#aaCluster {
    background-color: rgba(10, 10, 12, 210);
    border: 1px solid #2A2A30;
    border-radius: 10px;
}

QPushButton#aaFloatingButton {
    background: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 8px;
    padding: 0px;
}
QPushButton#aaFloatingButton:hover {
    border: 1px solid #D71920;
    background: #1E1E24;
}
QPushButton#aaFloatingButton:pressed {
    background: #D71920;
    border: 1px solid #D71920;
}

#devHint {
    color: #6E6E6E;
    font-size: 11px;
    letter-spacing: 1.2px;
}
QPushButton#nightToggle {
    background: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 6px;
    font-size: 11px;
    letter-spacing: 1.0px;
    padding: 4px 10px;
}
QPushButton#nightToggle:checked {
    background: #1A1A1A;
    border: 1px solid #3A3A40;
}

/* SOON badge on disabled quadrants */
QLabel#soonBadge {
    color: #9E9E9E;
    background: transparent;
    padding: 2px 6px;
}

/* ---- Race Mode v1 (object names, see RacePanels.cpp / MainWindow.cpp) ---- */
#racePage {
    background-color: #0D0D0F;
}

#navPanel,
#gaugePanel,
#gforcePanel {
    background-color: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 6px;
}

#navVideoSlot {
    background: transparent;
}

/* §40-41: the generic QWidget 14px rule wins over setFont() in code —
 * real sizes MUST live here (same pattern as #quadrant* 32px).
 * Gauge rows are right-anchored, units same size as their values. */
#raceSpeedValue {
    color: #F5F5F5;
    background: transparent;
    font-size: 88px;
    font-weight: bold;
}

#raceRpmValue {
    color: #F5F5F5;
    background: transparent;
    font-size: 72px;
    font-weight: bold;
}

#raceSpeedUnit {
    color: #9E9E9E;
    background: transparent;
    font-size: 88px;
}

#raceRpmUnit {
    color: #9E9E9E;
    background: transparent;
    font-size: 72px;
}

#raceGValue {
    font-size: 18px;
}

#raceGLabel {
    font-size: 12px;
}

#raceGValue {
    color: #F5F5F5;
    background: transparent;
}

#raceGLabel,
#navTitle {
    color: #9E9E9E;
    background: transparent;
    letter-spacing: 1.2px;
}

/* ---- Unified status bar (§39): [back] TITLE left, temp + clock right ---- */
#statusTitle {
    color: #F5F5F5;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 1.6px;
    background: transparent;
}

QPushButton#statusBackButton {
    background: #17171B;
    border: 1px solid #2A2A30;
    border-radius: 8px;
    padding: 0px;
}
QPushButton#statusBackButton:hover {
    border: 1px solid #D71920;
    background: #1E1E24;
}
QPushButton#statusBackButton:pressed {
    background: #D71920;
    border: 1px solid #D71920;
}
